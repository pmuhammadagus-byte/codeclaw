{
  "gateway": { "mode": "local", "httpPort": 3000 },
  "models": {
    "mode": "merge",
    "default": "9router/Combo",
    "providers": {
      "9router": {
        "baseUrl": "http://127.0.0.1:20128/v1",
        "apiKey": "REPLACE_WITH_9ROUTER_KEY",
        "api": "openai-completions",
        "models": [
          { "id": "Combo", "name": "Combo (Recommended)" },
          { "id": "glm-5.3", "name": "GLM 5.3" }
        ]
      }
    }
  },
  "agents": {
    "main": { "default": true, "model": "9router/Combo", "systemPromptFile": "system.md" }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "accounts": {
        "default": {
          "botToken": "REPLACE_WITH_BOTFATHER_TOKEN",
          "allowedUserIds": [123456789],
          "chatId": "123456789"
        }
      }
    }
  },
  "agent": {
    "maxToolIterations": 100,
    "contextWindow": 200,
    "approvalMode": "dangerous-only",
    "brainLevel": "smart"
  }
}
